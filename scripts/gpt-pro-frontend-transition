#!/bin/sh
set -eu
repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
python="${repo_root}/.venv/bin/python"
if [ ! -x "${python}" ]; then
    echo "gpt-pro-frontend-transition: missing private Python runtime ${python}" >&2
    exit 69
fi
exec "${python}" -m sudhir_codex_gateway.frontend_transition "$@"
